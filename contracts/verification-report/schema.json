{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogno-us/open-decision-evidence-standard/contracts/verification-report/schema.json",
  "title": "Verification report contract 0.1.0-draft",
  "description": "Draft optional ODES extension profile: the report an independent verifier emits about supplied records (three-valued verdicts with explicit k/n denominators, no composite score, mandatory does_not_prove block, subject and verifier identity) and the mutation-report shape. A verification report, not an attestation. Closed member sets; x- extensions allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "profile",
    "report_kind",
    "report_id",
    "generated_at",
    "verifier",
    "subject",
    "scope",
    "checks",
    "summary",
    "does_not_prove",
    "mutation_report"
  ],
  "properties": {
    "contract": {
      "const": "verification-report"
    },
    "contract_version": {
      "const": "0.1.0-draft"
    },
    "profile": {
      "const": "verification-report/0.1"
    },
    "report_kind": {
      "const": "verification_report"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "verifier": {
      "$ref": "#/$defs/verifier"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_claim"
      }
    },
    "mutation_report": {
      "oneOf": [
        {
          "$ref": "#/$defs/mutation_report"
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z0-9][a-z0-9._-]*(?!\\n)$"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "n"
      ],
      "properties": {
        "k": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "impact_fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k",
        "n"
      ],
      "properties": {
        "k": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "verdict_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reject",
        "accept",
        "abstain",
        "error"
      ],
      "properties": {
        "reject": {
          "type": "integer",
          "minimum": 0
        },
        "accept": {
          "type": "integer",
          "minimum": 0
        },
        "abstain": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "command",
        "source_revision",
        "canonicalization_profile"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "const": "cognous-verify"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "canonicalization_profile": {
          "enum": [
            "json-sort-keys-compact-utf8-no-nan-python-semantics-v0.1"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "name",
        "digest",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "run_record",
            "proposal_export",
            "manifest",
            "destination_ledger",
            "corpus",
            "operator_set",
            "witness",
            "holder_inventory"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization_profile",
        "inputs",
        "inputs_digest",
        "pinned"
      ],
      "properties": {
        "canonicalization_profile": {
          "enum": [
            "json-sort-keys-compact-utf8-no-nan-python-semantics-v0.1"
          ]
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/input"
          }
        },
        "inputs_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
        },
        "pinned": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controller_revision",
            "contract_versions",
            "reason_registry_digest"
          ],
          "properties": {
            "controller_revision": {
              "type": "string",
              "minLength": 1
            },
            "contract_versions": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "reason_registry_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
            },
            "extensions": {
              "$ref": "#/$defs/extensions"
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_quality",
        "tiers_run"
      ],
      "properties": {
        "semantic_quality": {
          "enum": [
            "not_assessed"
          ]
        },
        "tiers_run": {
          "type": "array",
          "items": {
            "enum": [
              "V1",
              "V2",
              "V3",
              "V4"
            ]
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "tally": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "could_not_check",
        "refuted",
        "n"
      ],
      "properties": {
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "could_not_check": {
          "type": "integer",
          "minimum": 0
        },
        "refuted": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "locator",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?!\\n)$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "tier",
        "verdict",
        "tally",
        "could_not_check_reason",
        "findings"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*(?!\\n)$"
        },
        "tier": {
          "enum": [
            "V1",
            "V2",
            "V3",
            "V4"
          ]
        },
        "verdict": {
          "enum": [
            "confirmed",
            "could_not_check",
            "refuted"
          ]
        },
        "tally": {
          "$ref": "#/$defs/tally"
        },
        "could_not_check_reason": {
          "oneOf": [
            {
              "enum": [
                "input_absent",
                "tier_unavailable",
                "profile_ambiguous",
                "not_applicable_to_input"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "confirmed",
        "could_not_check",
        "refuted"
      ],
      "properties": {
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "could_not_check": {
          "type": "integer",
          "minimum": 0
        },
        "refuted": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "non_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement"
      ],
      "properties": {
        "id": {
          "enum": [
            "relative_to_pinned_controller",
            "semantic_quality_not_certified",
            "receipt_source_bounded",
            "self_consistent_forgery_not_detected",
            "not_an_attestation",
            "parse_strictness_is_refusal_not_repair",
            "no_v1_scope_claim",
            "differential_agreement_is_not_equivalence",
            "no_imported_headline_numbers",
            "seeds_are_regression_not_detection",
            "witness_is_not_publication",
            "profile_sidecar_semantics_only"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "category": {
      "enum": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5",
        "B",
        "S1",
        "S2",
        "S3",
        "S4",
        "I1",
        "I2",
        "I3",
        "I4",
        "I5",
        "D1",
        "D2",
        "D3",
        "D4",
        "D5",
        "J1",
        "J2",
        "J3",
        "T1",
        "A1",
        "A2",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6",
        "X1",
        "L1",
        "F",
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7",
        "H8",
        "Q"
      ]
    },
    "trace_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "expected_verdict",
        "n_gen",
        "n_noop",
        "n_na",
        "n_eff",
        "verdicts",
        "detection",
        "regression",
        "false_acceptance",
        "abstained",
        "errored",
        "metric_impact"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/category"
        },
        "expected_verdict": {
          "enum": [
            "reject",
            "accept",
            "abstain",
            "not_applicable"
          ]
        },
        "n_gen": {
          "type": "integer",
          "minimum": 0
        },
        "n_noop": {
          "type": "integer",
          "minimum": 0
        },
        "n_na": {
          "type": "integer",
          "minimum": 0
        },
        "n_eff": {
          "type": "integer",
          "minimum": 0
        },
        "verdicts": {
          "$ref": "#/$defs/verdict_counts"
        },
        "detection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "any_code",
                "intended_code"
              ],
              "properties": {
                "any_code": {
                  "$ref": "#/$defs/fraction"
                },
                "intended_code": {
                  "$ref": "#/$defs/fraction"
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "regression": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "refused_with_intended_code"
              ],
              "properties": {
                "refused_with_intended_code": {
                  "$ref": "#/$defs/fraction"
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "false_acceptance": {
          "oneOf": [
            {
              "$ref": "#/$defs/fraction"
            },
            {
              "type": "null"
            }
          ]
        },
        "abstained": {
          "oneOf": [
            {
              "$ref": "#/$defs/fraction"
            },
            {
              "type": "null"
            }
          ]
        },
        "errored": {
          "oneOf": [
            {
              "$ref": "#/$defs/fraction"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric_impact": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "conditioned_on",
                "changed",
                "deltas"
              ],
              "properties": {
                "conditioned_on": {
                  "const": "false_acceptance"
                },
                "changed": {
                  "$ref": "#/$defs/impact_fraction"
                },
                "deltas": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "measure",
                      "nonzero_mutants",
                      "min",
                      "max"
                    ],
                    "properties": {
                      "measure": {
                        "enum": [
                          "unauthorized_effects",
                          "excess_duplicate_effects",
                          "authorized_count",
                          "held_count"
                        ]
                      },
                      "nonzero_mutants": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "min": {
                        "type": "integer"
                      },
                      "max": {
                        "type": "integer"
                      },
                      "extensions": {
                        "$ref": "#/$defs/extensions"
                      }
                    }
                  }
                },
                "extensions": {
                  "$ref": "#/$defs/extensions"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "family_t_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "provenance",
        "corpus_digest",
        "categories",
        "scenarios"
      ],
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "seed",
            "generated"
          ]
        },
        "corpus_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace_row"
          }
        },
        "scenarios": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scenario_id",
                  "categories"
                ],
                "properties": {
                  "scenario_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/trace_row"
                    }
                  },
                  "extensions": {
                    "$ref": "#/$defs/extensions"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "source_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "n_cases",
        "detected",
        "survived",
        "errored"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "n_cases": {
          "type": "integer",
          "minimum": 0
        },
        "detected": {
          "type": "integer",
          "minimum": 0
        },
        "survived": {
          "type": "integer",
          "minimum": 0
        },
        "errored": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "family_s_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "context_only",
        "rows"
      ],
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "context_only": {
          "const": true
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_row"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "clean_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "provenance",
        "corpus_digest",
        "rows"
      ],
      "properties": {
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "seed_valid_fixtures",
            "generated"
          ]
        },
        "corpus_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "false_rejection"
            ],
            "properties": {
              "category": {
                "$ref": "#/$defs/category"
              },
              "false_rejection": {
                "$ref": "#/$defs/fraction"
              },
              "extensions": {
                "$ref": "#/$defs/extensions"
              }
            }
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "mutation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_only",
        "operator_set_digest",
        "seed",
        "frozen_revision",
        "family_t",
        "family_s",
        "clean"
      ],
      "properties": {
        "report_only": {
          "const": true
        },
        "operator_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?!\\n)$"
        },
        "seed": {
          "type": "integer"
        },
        "frozen_revision": {
          "type": "string",
          "minLength": 1
        },
        "family_t": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_t_corpus"
          }
        },
        "family_s": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_s_corpus"
          }
        },
        "clean": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clean_corpus"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
