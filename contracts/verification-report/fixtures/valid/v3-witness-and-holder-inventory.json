    "does_not_prove": [
      {
        "id": "relative_to_pinned_controller",
        "statement": "The result holds for the controller revision (as declared by the caller; 'unstated' if none was declared), the contract draft versions and the reason registry named in subject.pinned. It does not carry to any other revision."
      },
      {
        "id": "semantic_quality_not_certified",
        "statement": "No claim that a decision was correct, that a policy was adequate, or that a grant was lawfully issued. The verifier checks structure, identity and agreement between records, not whether the decisions were right."
      },
      {
        "id": "receipt_source_bounded",
        "statement": "Destination checks cover only the rows in the supplied ledger snapshot. The snapshot has no sequence number, chain or signature, so completeness is not established: a dropped tail or a decision that never reached the ledger cannot be seen."
      },
      {
        "id": "self_consistent_forgery_not_detected",
        "statement": "A forged set of records in which every commitment was recomputed to agree is indistinguishable from a genuine one by these checks. Agreement between records is not evidence that they are genuine."
      },
      {
        "id": "not_an_attestation",
        "statement": "This is a verification report about supplied records. It is not signed, not an attestation, and authorizes nothing."
      },
      {
        "id": "parse_strictness_is_refusal_not_repair",
        "statement": "An input the strict parser refuses (duplicate members, NaN or Infinity, non-UTF-8, over-size, lone surrogates) is refused and reported, never repaired and re-read."
      },
      {
        "id": "no_v1_scope_claim",
        "statement": "No claim about the scope or release status of any V1 of the stack. Nothing here is a release, a publication or an endorsement."
      },
      {
        "id": "differential_agreement_is_not_equivalence",
        "statement": "Agreement with a reference validator on a fixture set is a check against common-mode error. It does not show that the two implementations are equivalent."
      },
      {
        "id": "witness_is_not_publication",
        "statement": "The witness is shown to match the records it was given; not that it was published, that it was published in time, or that a party independent of the record keeper held it; a witness file supplied by whoever supplied the records vouches for nothing that party could rewrite, and rows appended after the latest digest are not covered; only list-valued ledgers are covered; top-level scalars and dictionaries (run_id, input_time_floors) are not."
      }
    ],
