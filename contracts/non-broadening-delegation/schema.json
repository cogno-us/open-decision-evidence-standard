{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cogno-us/open-decision-evidence-standard/contracts/non-broadening-delegation/schema.json",
  "title": "Non-broadening delegation contract 0.1.0-draft",
  "description": "Draft optional ODES extension profile: the delegation record for a grant, and the rule that a delegated grant is a subset of its parent in amount, time window and scope. Closed member sets; x- extensions allowed. Cross-record rules are in validate.py and README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "profile",
    "grants"
  ],
  "properties": {
    "contract": {
      "const": "non-broadening-delegation"
    },
    "contract_version": {
      "const": "0.1.0-draft"
    },
    "profile": {
      "const": "non-broadening-delegation/0.1"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z0-9][a-z0-9._-]*(?!\\n)$"
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "targets",
        "data_scopes",
        "max_amount",
        "unit",
        "max_effects"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "max_amount": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "max_effects": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_grant_id",
        "may_delegate",
        "remaining_depth"
      ],
      "properties": {
        "parent_grant_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "may_delegate": {
          "type": "boolean"
        },
        "remaining_depth": {
          "type": "integer",
          "minimum": 0
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "revision",
        "issuer",
        "grantee",
        "not_before",
        "expires_at",
        "permissions",
        "delegation"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "grantee": {
          "type": "string",
          "minLength": 1
        },
        "not_before": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "delegation": {
          "$ref": "#/$defs/delegation"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
