    "transport_evidence": {
      "type": "object",
      "description": "Transport evidence summary. `unsupported` is the honest-limits list and must name all three limits.",
      "additionalProperties": false,
      "required": [
        "transport_profile",
        "transport_version",
        "message_id",
        "content_commitment",
        "outbox_state",
        "inbox_received_at",
        "recipient_processing_status",
        "delivery_attempts",
        "sender_acknowledgements",
        "recipient_acknowledgements",
        "producer_refs",
        "retained_artifact_summary",
        "namespace_rule",
        "unsupported"
      ],
      "properties": {
        "transport_profile": {
          "const": "urn:cognous:profiles:governed-message-transport:0.1.0"
        },
        "transport_version": {
          "const": "0.1.0"
        },
        "message_id": {
          "$ref": "#/$defs/text"
        },
        "content_commitment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "outbox_state": {
          "enum": [
            "QUEUED",
            "IN_FLIGHT",
            "DELIVERED",
            "PENDING_RETRY",
            "UNRESOLVED",
            "TERMINAL_REJECTED",
            null
          ]
        },
        "inbox_received_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipient_processing_status": {
          "enum": [
            "not_received",
            "retained",
            "unresolved_after_durable_receipt"
          ]
        },
        "delivery_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_delivery_attempt"
          }
        },
        "sender_acknowledgements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ack_row"
          }
        },
        "recipient_acknowledgements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ack_row"
          }
        },
        "producer_refs": {
          "$ref": "#/$defs/producer_refs"
        },
        "retained_artifact_summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/retained_artifact_summary"
            }
          ]
        },
        "namespace_rule": {
          "type": "string"
        },
        "unsupported": {
          "type": "array",
          "items": {
            "enum": [
              "cryptographically_authenticated_network_identity",
              "distributed_exactly_once_delivery",
              "independent_effect_verification"
            ]
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "delivery_result": {
      "type": "object",
      "description": "Sender-side summary returned by LocalDurableTransport.deliver (and recover_due). The qualification suites read transport_state from it. DELIVERED means a DURABLE_RECEIPT was received and nothing more.",
      "additionalProperties": false,
      "required": [
        "message_id",
        "transport_state",
        "attempted"
      ],
      "properties": {
        "message_id": {
          "$ref": "#/$defs/text"
        },
        "transport_state": {
          "enum": [
            "DELIVERED",
            "PENDING_RETRY",
            "UNRESOLVED",
            "TERMINAL_REJECTED",
            "BACKOFF"
          ]
        },
        "attempted": {
          "type": "boolean"
        },
        "delivery_attempt_id": {
          "$ref": "#/$defs/text"
        },
        "acknowledgement_received": {
          "type": "boolean"
        },
        "acknowledgement": {
          "$ref": "#/$defs/acknowledgement"
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "next_attempt_at": {
          "$ref": "#/$defs/timestamp"
        },
        "interruption": {
          "$ref": "#/$defs/text"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
