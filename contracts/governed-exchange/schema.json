          "type": "boolean"
        },
        "effect_created": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "loaded_for_reconciliation",
            "packet_digest_mismatch",
            "unsupported_profile_or_schema",
            "conversation_mismatch",
            "source_identity_mismatch",
            "source_commitment_mismatch",
            "unsupported_state_version",
            "missing_predecessor_packet_id",
            "divergent_branch",
            "source_not_accepted_head",
            "predecessor_digest_mismatch",
            "predecessor_content_not_accepted_head",
            "stale_or_rollback",
            "unknown_predecessor",
            "divergent_history"
          ]
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "evidence_delivery_attempt": {
      "type": "object",
      "additionalProperties": false,
